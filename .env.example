# Copy to .env and fill in. Everything works without any of this (rule parser + Chrome speech).

# --- Option A: local Mistral with Ollama (no key, works offline) ---
#   ollama pull mistral:7b
MISTRAL_BASE_URL=http://127.0.0.1:11434/v1
MISTRAL_MODEL=mistral:7b

# --- Option B: Mistral cloud API (comment out option A) ---
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_API_KEY=

# Server-side transcription fallback: browser | mistral | openai
STT_PROVIDER=browser
OPENAI_API_KEY=
